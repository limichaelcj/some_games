<%= render partial: 'gradient_ring_background' %>

<main>
  <p style="color: green"><%= notice %></p>

  <% content_for :title, "Games" %>

  <h1>Games</h1>

  <div id="games">
    <div class="container-lg">
      <div class="row row-cols-auto justify-content-center gx-3 gy-4">
        <% @games.each do |game| %>
          <div class="col">
            <%= link_to game, class: 'text-decoration-none text-reset' do %>
              <%= render game, payment_methods: @payment_methods %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= link_to "New game", new_game_path %>
</main>
